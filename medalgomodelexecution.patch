+{% extends "base.html" %}
+{% block title %}Benchmarks · MedAlgo Hub{% endblock %}
+{% block breadcrumb %}Benchmarks{% endblock %}
+
+{% block content %}
+<div class="flex items-center justify-between mb-1">
+  <h1 class="text-2xl font-semibold text-accent-ink">Benchmarks</h1>
+  {% if user.is_authenticated %}
+  <a href="{% url 'algorithms:benchmark_create' %}" class="px-4 py-2 rounded-lg bg-accent text-white text-sm hover:opacity-90">Create Benchmark</a>
+  {% endif %}
+</div>
+<p class="text-slate-500 mb-5">Compare models side by side on the same task and dataset.</p>
+
+<form hx-get="{% url 'algorithms:benchmark_list' %}"
+      hx-target="#benchmark-results"
+      hx-swap="innerHTML"
+      hx-trigger="keyup changed delay:300ms from:input, change from:select"
+      class="bg-white rounded-xl border border-slate-200 p-3 mb-5 flex flex-wrap gap-3 items-center">
+  <input type="search" name="q" value="{{ q }}" placeholder="Search benchmarks..."
+         class="flex-1 min-w-[200px] px-3 py-2 rounded-lg border border-slate-200 focus:border-accent outline-none text-sm">
+  <select name="modality" class="px-3 py-2 rounded-lg border border-slate-200 text-sm">
+    <option value="">All modalities</option>
+    {% for value, label in modalities %}
+      <option value="{{ value }}" {% if value == active_modality %}selected{% endif %}>{{ label }}</option>
+    {% endfor %}
+  </select>
+</form>
+
+<div id="benchmark-results">
+  <p class="text-xs text-slate-400 mb-3">{{ count }} benchmark{{ count|pluralize }}</p>
+  {% if benchmarks %}
+  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
+    {% for b in benchmarks %}
+    {% include "benchmarks/_benchmark_card.html" %}
+    {% endfor %}
+  </div>
+  {% else %}
+  <div class="text-center text-slate-400 py-16 border border-dashed border-slate-200 rounded-xl">
+    No benchmarks match your search.
+  </div>
+  {% endif %}
+</div>
+{% endblock %}

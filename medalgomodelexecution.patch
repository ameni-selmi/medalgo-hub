--- /dev/null
+++ b/templates/registration/register.html
@@ -0,0 +1,66 @@
+{% extends "base.html" %}
+{% block title %}Register · MedAlgo Hub{% endblock %}
+{% block breadcrumb %}Register{% endblock %}
+
+{% block content %}
+<div class="max-w-md mx-auto py-8">
+  <h1 class="text-2xl font-semibold text-accent-ink mb-6 text-center">Create Account</h1>
+
+  {% if form.errors %}
+  <div class="bg-rose-50 border border-rose-200 rounded-xl p-4 mb-5 text-sm text-rose-700">
+    <ul class="list-disc list-inside">
+      {% for field, errors in form.errors.items %}
+        {% for error in errors %}<li>{{ error }}</li>{% endfor %}
+      {% endfor %}
+    </ul>
+  </div>
+  {% endif %}
+
+  <form method="post" class="bg-white rounded-xl border border-slate-200 p-6 space-y-4">
+    {% csrf_token %}
+    <div>
+      <label class="block text-sm font-medium text-slate-700 mb-1">Username</label>
+      <input type="text" name="username" value="{{ form.username.value|default_if_none:'' }}" required
+             class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:border-accent outline-none text-sm">
+    </div>
+    <div>
+      <label class="block text-sm font-medium text-slate-700 mb-1">Email</label>
+      <input type="email" name="email" value="{{ form.email.value|default_if_none:'' }}" required
+             class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:border-accent outline-none text-sm">
+    </div>
+    <div>
+      <label class="block text-sm font-medium text-slate-700 mb-1">Institution</label>
+      <input type="text" name="institution" value="{{ form.institution.value|default_if_none:'' }}" required
+             class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:border-accent outline-none text-sm"
+             placeholder="e.g. Johns Hopkins University">
+    </div>
+    <div>
+      <label class="block text-sm font-medium text-slate-700 mb-1">ORCID (optional)</label>
+      <input type="text" name="orcid" value="{{ form.orcid.value|default_if_none:'' }}"
+             class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:border-accent outline-none text-sm"
+             placeholder="0000-0000-0000-0000">
+    </div>
+    <div>
+      <label class="block text-sm font-medium text-slate-700 mb-1">Bio (optional)</label>
+      <textarea name="bio" rows="3"
+                class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:border-accent outline-none text-sm">{{ form.bio.value|default_if_none:'' }}</textarea>
+    </div>
+    <div>
+      <label class="block text-sm font-medium text-slate-700 mb-1">Password</label>
+      <input type="password" name="password1" required
+             class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:border-accent outline-none text-sm">
+    </div>
+    <div>
+      <label class="block text-sm font-medium text-slate-700 mb-1">Confirm Password</label>
+      <input type="password" name="password2" required
+             class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:border-accent outline-none text-sm">
+    </div>
+    <button type="submit" class="w-full px-4 py-2.5 rounded-lg bg-accent text-white font-medium hover:opacity-90">Register</button>
+    <p class="text-xs text-slate-400 text-center">Your profile will require admin approval before you can upload models.</p>
+  </form>
+
+  <p class="text-center text-sm text-slate-500 mt-4">
+    Already have an account? <a href="{% url 'login' %}" class="text-accent hover:underline">Sign In</a>
+  </p>
+</div>
+{% endblock %}

+{% extends "base.html" %}
+{% block title %}Upload Successful · MedAlgo Hub{% endblock %}
+{% block breadcrumb %}Model Hub / Upload{% endblock %}
+
+{% block content %}
+<div class="max-w-lg mx-auto text-center py-16">
+  <div class="w-16 h-16 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto mb-4 text-2xl">
+    &#10003;
+  </div>
+  <h1 class="text-2xl font-semibold text-accent-ink mb-2">Model Submitted</h1>
+  <p class="text-slate-500 mb-6">
+    <strong>{{ ml_model.name }}</strong> has been submitted for review.
+    An admin will review and publish it shortly.
+  </p>
+  <div class="flex gap-3 justify-center">
+    <a href="{% url 'algorithms:model_detail' ml_model.slug %}" class="px-4 py-2 rounded-lg bg-accent text-white text-sm hover:opacity-90">View Model</a>
+    <a href="{% url 'algorithms:model_upload' %}" class="px-4 py-2 rounded-lg border border-slate-200 text-slate-600 text-sm hover:border-accent">Upload Another</a>
+  </div>
+</div>
+{% endblock %}
diff --git a/templates/registration/login.html b/templates/registration/login.html
new file mode 100644
index 0000000..12e936b
--- /dev/null
+++ b/templates/registration/login.html
@@ -0,0 +1,34 @@
+{% extends "base.html" %}
+{% block title %}Sign In · MedAlgo Hub{% endblock %}
+{% block breadcrumb %}Sign In{% endblock %}
+
+{% block content %}
+<div class="max-w-md mx-auto py-8">
+  <h1 class="text-2xl font-semibold text-accent-ink mb-6 text-center">Sign In</h1>
+
+  {% if form.errors %}
+  <div class="bg-rose-50 border border-rose-200 rounded-xl p-4 mb-5 text-sm text-rose-700">
+    Invalid username or password. Please try again.
+  </div>
+  {% endif %}
+
+  <form method="post" class="bg-white rounded-xl border border-slate-200 p-6 space-y-4">
+    {% csrf_token %}
+    <div>
+      <label class="block text-sm font-medium text-slate-700 mb-1">Username</label>
+      <input type="text" name="username" autofocus required
+             class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:border-accent outline-none text-sm">
+    </div>
+    <div>
+      <label class="block text-sm font-medium text-slate-700 mb-1">Password</label>
+      <input type="password" name="password" required
+             class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:border-accent outline-none text-sm">
+    </div>
+    <button type="submit" class="w-full px-4 py-2.5 rounded-lg bg-accent text-white font-medium hover:opacity-90">Sign In</button>
+  </form>
+
+  <p class="text-center text-sm text-slate-500 mt-4">
+    Don't have an account? <a href="{% url 'register' %}" class="text-accent hover:underline">Register</a>
+  </p>
+</div>
+{% endblock %}
diff --git a/templates/registration/register.html b/templates/registration/register.html
new file mode 100644

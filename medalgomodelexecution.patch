+<div class="bg-white rounded-xl border border-slate-200 p-5">
+  <h3 class="font-semibold text-accent-ink mb-4">Side-by-Side Comparison</h3>
+
+  <div class="overflow-x-auto">
+    <table class="w-full text-sm">
+      <thead>
+        <tr class="border-b border-slate-200">
+          <th class="text-left px-4 py-2 text-slate-500">Metric</th>
+          {% for entry in entries %}
+          <th class="text-right px-4 py-2 font-medium text-accent-ink">{{ entry.model_name }}</th>
+          {% endfor %}
+        </tr>
+      </thead>
+      <tbody>
+        {% for key in metric_keys %}
+        <tr class="border-b border-slate-100">
+          <td class="px-4 py-2 text-slate-600 capitalize">{{ key }}</td>
+          {% for entry in entries %}
+          <td class="text-right px-4 py-2">
+            {% if entry.metrics %}
+              {% for mk, mv in entry.metrics.items %}{% if mk == key %}{{ mv }}{% endif %}{% endfor %}
+            {% else %}-{% endif %}
+          </td>
+          {% endfor %}
+        </tr>
+        {% endfor %}
+      </tbody>
+    </table>
+  </div>
+</div>
diff --git a/templates/benchmarks/_comparison_table.html b/templates/benchmarks/_comparison_table.html
new file mode 100644
index 0000000..8a23571
--- /dev/null
+++ b/templates/benchmarks/_comparison_table.html
@@ -0,0 +1,49 @@
+<div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
+  <div class="overflow-x-auto">
+    <table class="w-full text-sm">
+      <thead>
+        <tr class="bg-slate-50 border-b border-slate-200">
+          <th class="text-left px-4 py-3 font-medium text-slate-600">#</th>
+          <th class="text-left px-4 py-3 font-medium text-slate-600">Model</th>
+          {% for key in metric_keys %}
+          <th class="text-right px-4 py-3 font-medium text-slate-600 cursor-pointer hover:text-accent"
+              hx-get="{% url 'algorithms:benchmark_detail' benchmark.slug %}?sort={{ key }}&dir={% if sort_by == key and sort_dir == 'desc' %}asc{% else %}desc{% endif %}"
+              hx-target="closest .bg-white"
+              hx-swap="outerHTML">
+            <span class="capitalize">{{ key }}</span>
+            {% if sort_by == key %}
+              <span class="ml-1">{% if sort_dir == 'desc' %}&#9660;{% else %}&#9650;{% endif %}</span>
+            {% endif %}
+          </th>
+          {% endfor %}
+          <th class="px-4 py-3"></th>
+        </tr>
+      </thead>
+      <tbody>
+        {% for entry in entries %}
+        <tr class="border-b border-slate-100 {% if entry.is_highlighted %}bg-amber-50/50{% elif forloop.counter|divisibleby:2 %}bg-slate-50/50{% endif %} hover:bg-slate-50">
+          <td class="px-4 py-3 text-slate-400">{{ forloop.counter }}</td>
+          <td class="px-4 py-3 font-medium text-accent-ink">
+            {{ entry.model_name }}
+            {% if entry.is_highlighted %}<span class="ml-1 text-amber-500">&#127942;</span>{% endif %}
+          </td>
+          {% for key in metric_keys %}
+          <td class="text-right px-4 py-3 {% if entry.metrics and best_values|dictsort:key and entry.metrics.key == best_values.key %}text-emerald-600 font-semibold{% endif %}">
+            {% if entry.metrics %}
+              {% for mk, mv in entry.metrics.items %}
+                {% if mk == key %}{{ mv }}{% endif %}
+              {% endfor %}
+            {% else %}-{% endif %}
+          </td>
+          {% endfor %}
+          <td class="px-4 py-3">
+            {% if entry.model %}
+            <a href="{{ entry.model.get_absolute_url }}" class="text-xs text-accent hover:underline">Try</a>
+            {% endif %}
+          </td>
+        </tr>
+        {% endfor %}
+      </tbody>
+    </table>
+  </div>
+</div>
diff --git a/templates/benchmarks/create.html b/templates/benchmarks/create.html
new file mode 100644
index 0000000..d78e775
--- /dev/null
+++ b/templates/benchmarks/create.html
@@ -0,0 +1,158 @@
+{% extends "base.html" %}
+{% block title %}{% if editing %}Edit{% else %}Create{% endif %} Benchmark · MedAlgo Hub{% endblock %}
+{% block breadcrumb %}Benchmarks / {% if editing %}Edit{% else %}Create{% endif %}{% endblock %}
+
+{% block content %}
+<h1 class="text-2xl font-semibold text-accent-ink mb-1">{% if editing %}Edit Benchmark{% else %}Create a Benchmark{% endif %}</h1>
+<p class="text-slate-500 mb-5">Compare multiple models on the same task and dataset.</p>
+
+{% if error %}
+<div class="bg-rose-50 border border-rose-200 rounded-xl p-4 mb-5 text-sm text-rose-700">{{ error }}</div>
+{% endif %}
+
+{% if form %}
+<form method="post" class="space-y-6 max-w-3xl">
+  {% csrf_token %}
+
+  {% if form.errors %}
+  <div class="bg-rose-50 border border-rose-200 rounded-xl p-4 text-sm text-rose-700">{{ form.errors }}</div>
+  {% endif %}
+
+  <div class="bg-white rounded-xl border border-slate-200 p-5">
+    <h2 class="font-semibold text-accent-ink mb-4">Benchmark Information</h2>
+    <div class="space-y-4">
+      <div>
+        <label class="block text-sm font-medium text-slate-700 mb-1">Name</label>
+        <input type="text" name="name" value="{{ form.name.value|default_if_none:'' }}" required
+               class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:border-accent outline-none text-sm">
+      </div>
+      <div>
+        <label class="block text-sm font-medium text-slate-700 mb-1">Description</label>
+        <textarea name="description" rows="4"
+                  class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:border-accent outline-none text-sm">{{ form.description.value|default_if_none:'' }}</textarea>
+      </div>
+      <div>
+        <label class="block text-sm font-medium text-slate-700 mb-1">Clinical Task</label>
+        <input type="text" name="clinical_task" value="{{ form.clinical_task.value|default_if_none:'' }}" required
+               class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:border-accent outline-none text-sm">
+      </div>
+      <div class="grid grid-cols-2 gap-4">
+        <div>
+          <label class="block text-sm font-medium text-slate-700 mb-1">Modality</label>
+          <select name="modality" required class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm">
+            {% for value, label in form.modality.field.choices %}
+            <option value="{{ value }}" {% if form.modality.value == value %}selected{% endif %}>{{ label }}</option>
+            {% endfor %}
+          </select>
+        </div>
+        <div>
+          <label class="block text-sm font-medium text-slate-700 mb-1">Body Region</label>
+          <select name="body_region" required class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm">
+            {% for value, label in form.body_region.field.choices %}
+            <option value="{{ value }}" {% if form.body_region.value == value %}selected{% endif %}>{{ label }}</option>
+            {% endfor %}
+          </select>
+        </div>
+      </div>
+      <div class="grid grid-cols-2 gap-4">
+        <div>
+          <label class="block text-sm font-medium text-slate-700 mb-1">Dataset Name</label>
+          <input type="text" name="dataset_name" value="{{ form.dataset_name.value|default_if_none:'' }}" required
+                 class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm">
+        </div>
+        <div>
+          <label class="block text-sm font-medium text-slate-700 mb-1">Dataset Size</label>
+          <input type="number" name="dataset_size" value="{{ form.dataset_size.value|default_if_none:'' }}"
+                 class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm">
+        </div>
+      </div>
+      <div>
+        <label class="block text-sm font-medium text-slate-700 mb-1">Dataset Description</label>
+        <textarea name="dataset_description" rows="3"
+                  class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm">{{ form.dataset_description.value|default_if_none:'' }}</textarea>
+      </div>
+    </div>
+  </div>
+
+  <!-- Entries -->
+  <div class="bg-white rounded-xl border border-slate-200 p-5" id="entries-container">
+    <h2 class="font-semibold text-accent-ink mb-4">Model Entries</h2>
+    <div id="entry-list" class="space-y-4">
+      <div class="entry-row border border-slate-100 rounded-lg p-4" data-index="0">
+        <div class="grid grid-cols-2 gap-4 mb-3">
+          <div>
+            <label class="block text-xs font-medium text-slate-700 mb-1">Model Name</label>
+            <input type="text" name="entry-0-model_name" required
+                   class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm" placeholder="e.g. ResNet18 (ImageNet pretrain)">
+          </div>
+          <div>
+            <label class="block text-xs font-medium text-slate-700 mb-1">Link to Platform Model (optional)</label>
+            <select name="entry-0-model" class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm">
+              <option value="">-- None --</option>
+              {% for m in published_models %}
+              <option value="{{ m.pk }}">{{ m.name }}</option>
+              {% endfor %}
+            </select>
+          </div>
+        </div>
+        <div class="mb-3">
+          <label class="block text-xs font-medium text-slate-700 mb-1">Pipeline Description</label>
+          <textarea name="entry-0-pipeline_description" rows="2"
+                    class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm"></textarea>
+        </div>
+        <div class="mb-3">
+          <label class="block text-xs font-medium text-slate-700 mb-1">Metrics (one per line: name: value)</label>
+          <textarea name="entry-0-metrics_text" rows="3"
+                    class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm font-mono"
+                    placeholder="accuracy: 0.92&#10;auc: 0.96&#10;f1: 0.91"></textarea>
+        </div>
+        <label class="flex items-center gap-2 text-xs">
+          <input type="checkbox" name="entry-0-is_highlighted" class="rounded">
+          Highlight as best
+        </label>
+      </div>
+    </div>
+    <button type="button" onclick="addEntry()" class="mt-4 text-sm text-accent hover:underline">+ Add Model Entry</button>
+  </div>
+
+  <button type="submit" class="px-6 py-3 rounded-lg bg-accent text-white font-medium hover:opacity-90">
+    {% if editing %}Save Changes{% else %}Submit for Review{% endif %}
+  </button>
+</form>
+
+<script>
+let entryCount = 1;
+function addEntry() {
+  const idx = entryCount++;
+  const html = `
+  <div class="entry-row border border-slate-100 rounded-lg p-4" data-index="${idx}">
+    <div class="grid grid-cols-2 gap-4 mb-3">
+      <div>
+        <label class="block text-xs font-medium text-slate-700 mb-1">Model Name</label>
+        <input type="text" name="entry-${idx}-model_name" required class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm">
+      </div>
+      <div>
+        <label class="block text-xs font-medium text-slate-700 mb-1">Link to Platform Model</label>
+        <select name="entry-${idx}-model" class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm">
+          <option value="">-- None --</option>
+          {% for m in published_models %}<option value="{{ m.pk }}">{{ m.name }}</option>{% endfor %}
+        </select>
+      </div>
+    </div>
+    <div class="mb-3">
+      <label class="block text-xs font-medium text-slate-700 mb-1">Pipeline Description</label>
+      <textarea name="entry-${idx}-pipeline_description" rows="2" class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm"></textarea>
+    </div>
+    <div class="mb-3">
+      <label class="block text-xs font-medium text-slate-700 mb-1">Metrics</label>
+      <textarea name="entry-${idx}-metrics_text" rows="3" class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm font-mono" placeholder="accuracy: 0.92&#10;auc: 0.96"></textarea>
+    </div>
+    <label class="flex items-center gap-2 text-xs">
+      <input type="checkbox" name="entry-${idx}-is_highlighted" class="rounded"> Highlight as best
+    </label>
+  </div>`;
+  document.getElementById('entry-list').insertAdjacentHTML('beforeend', html);
+}
+</script>
+{% endif %}
+{% endblock %}
diff --git a/templates/benchmarks/detail.html b/templates/benchmarks/detail.html
new file mode 100644
index 0000000..d2861f7
--- /dev/null
+++ b/templates/benchmarks/detail.html
@@ -0,0 +1,111 @@
+{% extends "base.html" %}
+{% block title %}{{ benchmark.name }} · MedAlgo Hub{% endblock %}
+{% block breadcrumb %}Benchmarks / {{ benchmark.name }}{% endblock %}
+
+{% block content %}
+<style>
+  @media print {
+    aside, header, nav { display: none !important; }
+    main { margin: 0; padding: 0; }
+    .no-print { display: none !important; }
+  }
+  .bar-animate { animation: growBar 0.6s ease-out forwards; }
+  @keyframes growBar { from { width: 0; } }
+</style>
+
+<div class="mb-6">
+  <div class="flex items-center gap-2 flex-wrap">
+    <h1 class="text-2xl font-semibold text-accent-ink">{{ benchmark.name }}</h1>
+    <span class="text-[10px] uppercase px-1.5 py-0.5 rounded bg-accent/10 text-accent">{{ benchmark.get_modality_display }}</span>
+  </div>
+  <p class="text-sm text-slate-500 mt-1">
+    {{ benchmark.clinical_task }} · {{ benchmark.get_body_region_display }} ·
+    by <span class="font-medium">{{ benchmark.researcher.username }}</span>
+  </p>
+  {% if benchmark.description %}
+  <p class="text-slate-600 mt-3 max-w-3xl">{{ benchmark.description }}</p>
+  {% endif %}
+</div>
+
+<!-- Dataset Info -->
+<div class="bg-white rounded-xl border border-slate-200 p-4 mb-6 text-sm">
+  <h3 class="font-semibold text-accent-ink mb-2">Dataset</h3>
+  <dl class="grid grid-cols-2 md:grid-cols-4 gap-2">
+    <div><dt class="text-slate-500">Name</dt><dd class="font-medium">{{ benchmark.dataset_name }}</dd></div>
+    {% if benchmark.dataset_size %}<div><dt class="text-slate-500">Size</dt><dd>{{ benchmark.dataset_size }} samples</dd></div>{% endif %}
+    {% if benchmark.dataset_description %}<div class="col-span-2"><dt class="text-slate-500">Description</dt><dd>{{ benchmark.dataset_description }}</dd></div>{% endif %}
+  </dl>
+</div>
+
+<!-- Comparison Table -->
+{% include "benchmarks/_comparison_table.html" %}
+
+<!-- Bar Charts -->
+{% if metric_keys %}
+<div class="mt-8">
+  <h2 class="font-semibold text-accent-ink mb-4">Metric Comparison</h2>
+  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
+    {% for key in metric_keys %}
+    <div class="bg-white rounded-xl border border-slate-200 p-4">
+      <h3 class="text-sm font-medium text-slate-600 mb-3 capitalize">{{ key }}</h3>
+      <div class="space-y-2">
+        {% for entry in entries %}
+        {% if entry.metrics and key in entry.metrics %}
+        <div class="flex items-center gap-2">
+          <span class="text-xs text-slate-500 w-28 truncate">{{ entry.model_name }}</span>
+          <div class="flex-1 h-5 rounded bg-slate-100 overflow-hidden">
+            {% with val=entry.metrics|dictsort:key %}
+            <div class="h-full rounded bar-animate {% if entry.is_highlighted %}bg-accent{% else %}bg-slate-400{% endif %}"
+                 style="width: {% widthratio entry.metrics.key 1 100 %}%"></div>
+            {% endwith %}
+          </div>
+          <span class="text-xs text-slate-600 w-12 text-right">{{ entry.metrics|dictsort:key|first|last|default_if_none:"-" }}</span>
+        </div>
+        {% endif %}
+        {% endfor %}
+      </div>
+    </div>
+    {% endfor %}
+  </div>
+</div>
+{% endif %}
+
+<!-- Pipeline Details -->
+<div class="mt-8">
+  <h2 class="font-semibold text-accent-ink mb-4">Pipeline Details</h2>
+  <div class="space-y-3">
+    {% for entry in entries %}
+    <details class="bg-white rounded-xl border border-slate-200">
+      <summary class="p-4 cursor-pointer text-sm font-medium text-accent-ink hover:bg-slate-50 rounded-xl">
+        {{ entry.model_name }}
+        {% if entry.is_highlighted %}<span class="ml-2 text-amber-500">&#127942;</span>{% endif %}
+      </summary>
+      <div class="px-4 pb-4 text-sm text-slate-600">
+        {% if entry.pipeline_description %}
+        <p class="mb-2">{{ entry.pipeline_description|linebreaks }}</p>
+        {% endif %}
+        {% if entry.training_details %}
+        <div class="mt-2">
+          <p class="font-medium text-slate-700 mb-1">Training Details</p>
+          <dl class="grid grid-cols-2 gap-1 text-xs">
+            {% for k, v in entry.training_details.items %}
+            <div><dt class="text-slate-500">{{ k }}</dt><dd>{{ v }}</dd></div>
+            {% endfor %}
+          </dl>
+        </div>
+        {% endif %}
+        {% if entry.model %}
+        <a href="{{ entry.model.get_absolute_url }}" class="inline-block mt-3 text-accent text-sm hover:underline">Try this model &#8594;</a>
+        {% endif %}
+      </div>
+    </details>
+    {% endfor %}
+  </div>
+</div>
+
+{% if user == benchmark.researcher %}
+<div class="mt-6 no-print">
+  <a href="{% url 'algorithms:benchmark_edit' benchmark.slug %}" class="text-sm text-accent hover:underline">Edit Benchmark</a>
+</div>
+{% endif %}
+{% endblock %}
